SCHEDULE_PASSWORD=change-me-123!
# Пароль администратора (мин. 8 символов, цифра и спецсимвол !@#$%^&*()_+-=)
# Это шаблон: задайте свой пароль, не оставляйте значение из примера.

SCHEDULE_SECRET_KEY=
# Опционально. Если пусто — ключ сгенерируется при первом старте и допишется в .env.
# Не переносите сюда ключ из чужого .env: одинаковый ключ у всех = подделка сессий.

FLASK_DEBUG=
# Включить режим отладки (1/true/yes). На рабочем сервере оставляйте пустым.
